# Copie para .env.local (desenvolvimento) e configure os mesmos nomes na Vercel
# (Project › Settings › Environment Variables).
# Nunca faça commit do arquivo preenchido. Detalhes em docs/SCHEMA.md.

# Estágio de publicação: preview (faixa, "a confirmar", noindex) ou production
SITE_STAGE=preview
# Endereço público. Na prévia, deixe vazio: o site usa o endereço .vercel.app do projeto.
SITE_URL=

# Rota /api/contato na Vercel (segredos; nunca no navegador nem com NEXT_PUBLIC_)
SUPABASE_URL=
# Chave secreta do Supabase (Settings › API Keys › Secret keys, "sb_secret_…"); a service_role antiga também funciona
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
LEAD_NOTIFY_TO=
# Remetente verificado no Resend (ex.: "Site GWL <site@gwlcorretora.com.br>")
LEAD_NOTIFY_FROM=
# Prévia: "teste" (só aceita nomes que começam com TESTE). Produção: "todos"
ACEITAR_LEADS=teste

# Públicos por natureza (vão para o build). A chave do Turnstile é criada no painel da Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

# Não usado: o navegador não acessa o banco (SCHEMA.md)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
