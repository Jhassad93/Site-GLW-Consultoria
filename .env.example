# Copie para .env.local (desenvolvimento) e configure os mesmos nomes na Cloudflare.
# Nunca faça commit do arquivo preenchido. Detalhes em docs/SCHEMA.md.

# Estágio de publicação: preview (faixa, "a confirmar", noindex) ou production
SITE_STAGE=preview
SITE_URL=https://gwlcorretora.com.br

# Função da Cloudflare /api/contato (segredos; nunca no navegador)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
LEAD_NOTIFY_TO=
# Remetente verificado no Resend (ex.: "Site GWL <site@gwlcorretora.com.br>")
LEAD_NOTIFY_FROM=
# Prévia: "teste" (só aceita nomes que começam com TESTE). Produção: "todos"
ACEITAR_LEADS=teste

# Públicos por natureza (vão para o build)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_GA_ID=

# Não usado: o navegador não acessa o banco (SCHEMA.md)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
